# .gitignore

# Log files
php-error.log
*.log

# Uploaded content (usually excluded)
uploads/
saved_audio/
saved_image/

# OS-specific
.DS_Store
Thumbs.db

# IDE-specific
.vscode/
.idea/
*.swp
*.swo

# Temporary files
/tmp/
# Ignore uploads but keep folders
saved_audio/*
!saved_audio/.gitkeep
saved_image/*
!saved_image/.gitkeep

# Ignore DB files or logs if any
*.log

# Ignore profile pictures but keep the folder
profile_pictures/*
!profile_pictures/.gitkeep

